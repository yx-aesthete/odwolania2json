# Skopiuj do .env (plik .env nie trafia do repo). Wszystko opcjonalne: bez tego działają same reguły.
# Tryb modelu (nadpisuje config/model.yaml): api | lokalny | brak
MODEL_TRYB=api
# Tryb api: Scaleway Generative APIs (UE), model open-weights; bez klucza działają same reguły
LLM_BASE_URL=https://api.scaleway.ai/v1
LLM_MODEL=gemma-4-26b-a4b-it
LLM_API_KEY=
# Tryb lokalny: serwer zgodny z OpenAI API na tej maszynie (np. Ollama)
# OLLAMA_URL=http://127.0.0.1:11434
# LOKALNY_MODEL=qwen2.5:7b
